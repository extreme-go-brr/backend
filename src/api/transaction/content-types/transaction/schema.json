{
  "kind": "collectionType",
  "collectionName": "transactions",
  "info": {
    "singularName": "transaction",
    "pluralName": "transactions",
    "displayName": "transaction"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "orderId": {
      "type": "string"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "transactions"
    },
    "transaction_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::transaction-item.transaction-item",
      "mappedBy": "transaction"
    },
    "order_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "packing",
        "ready",
        "completed"
      ]
    },
    "totalAmount": {
      "type": "decimal"
    },
    "notes": {
      "type": "string"
    },
    "shippingAddress": {
      "type": "string"
    },
    "shipment_detail": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::shipment-detaill.shipment-detaill",
      "mappedBy": "transaction"
    }
  }
}
